# Copy to .env and fill in. Never commit .env.
CORE_API_URL=https://giving-api.onrender.com
INTERNAL_TOKEN=
FAKE_CORE=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

MCP_SERVER_PATH=../mcp-server/server.py

# DRY_RUN=true (the default) makes every mutating MCP tool a no-op that returns a fake result.
DRY_RUN=true

WEB_ORIGIN=http://localhost:3000
GIVING_INTERVAL_HOURS=720
WATCHDOG_INTERVAL_SECONDS=300
MILESTONE_INTERVAL_SECONDS=600
