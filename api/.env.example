# Copy to .env and fill in. Never commit .env.

# PayPal REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox: https://api-m.sandbox.paypal.com   live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the dashboard (needed from Day 4 for signature verification)
PAYPAL_WEBHOOK_ID=

# Postgres on Render, e.g. postgresql+psycopg://user:pass@host:5432/db
# Leave unset locally to use a SQLite file (giving.db)
DATABASE_URL=

# All PayPal money moves in this currency (KES is not a PayPal transaction currency)
CURRENCY=USD
# Donation limits in minor units (cents)
MIN_DONATION_CENTS=100
MAX_DONATION_CENTS=100000

# Comma-separated origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000
