# Copy to .env and fill in. Never commit .env.

# PayPal REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox: https://api-m.sandbox.paypal.com   live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the dashboard (needed from Day 4 for signature verification)
PAYPAL_WEBHOOK_ID=

# Postgres on Render, e.g. postgresql+psycopg://user:pass@host:5432/db
# Leave unset locally to use a SQLite file (giving.db)
DATABASE_URL=

# All PayPal money moves in this currency (KES is not a PayPal transaction currency)
CURRENCY=USD
# Donation limits in minor units (cents)
MIN_DONATION_CENTS=100
MAX_DONATION_CENTS=100000

# Bearer tokens (any long random string). Agents send INTERNAL_TOKEN to /internal/*,
# the admin console sends ADMIN_TOKEN to /admin/*. Empty = those routes refuse everything.
INTERNAL_TOKEN=
ADMIN_TOKEN=

# Routes not built yet answer with their spec example and an X-Stub header (true),
# or with 501 NOT_IMPLEMENTED (false)
STUB_EXAMPLES=true

# Seconds between projected-match recomputes for the open round (0 = off)
PROJECTION_INTERVAL_SECONDS=300

# Milestone tranches up to this many cents release without an admin (all checks must pass)
MILESTONE_AUTO_RELEASE_CENTS=50000

# Comma-separated origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000
