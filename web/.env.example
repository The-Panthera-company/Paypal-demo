# Leave empty to use local mock data. Set to the Postman mock URL, then the real API.
NEXT_PUBLIC_API_URL=
# PayPal sandbox client ID (public; never put the secret here)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Admin console (server-side only, never NEXT_PUBLIC_): the core API's ADMIN_TOKEN
ADMIN_TOKEN=
# Password for /admin in the browser (any user name). Always set it on Render.
ADMIN_UI_PASSWORD=
# Person 3's agent service for the giving assistant (empty = keyword-search fallback)
NEXT_PUBLIC_AGENTS_URL=
